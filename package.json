{
  "name": "agent-playground-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal local harness for running, tracing, replaying, and evaluating agents.",
  "license": "MIT",
  "keywords": [
    "agent",
    "evaluation",
    "harness",
    "replay",
    "trace"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "artifacts/README.md"
  ],
  "bin": {
    "agent-harness": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "dev": "tsx src/bin.ts",
    "start": "node dist/bin.js",
    "demo": "npm run build && node scripts/demo-integration-test.mjs",
    "test:real-model": "node --env-file=.env ./node_modules/vitest/vitest.mjs run test/unit/openai-model.contract.test.ts",
    "test:install": "node scripts/install-validation.mjs",
    "test:fresh": "node scripts/fresh-environment-validation.mjs",
    "test:stability": "npm run build && node scripts/stability-validation.mjs",
    "test:scope": "npm run build && node scripts/scope-validation.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:integration": "npm run build && node scripts/smoke-test.mjs && node scripts/config-integration-test.mjs && node scripts/runtime-integration-test.mjs && node scripts/tool-context-integration-test.mjs && node scripts/trace-integration-test.mjs && node scripts/eval-integration-test.mjs && node scripts/demo-integration-test.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:integration"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "npm@11.11.0",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
